-def _autofit_height(value: int) -> int:
+def _autofit_height(value: int, zoom: float = 1.0) -> int:
     """Bound a height the app chose for itself, not one the user chose."""
-    return max(WINDOW_MIN_HEIGHT, min(value, WINDOW_AUTOFIT_MAX_HEIGHT))
+    return max(_zpx(WINDOW_MIN_HEIGHT, zoom), min(value, _zpx(WINDOW_AUTOFIT_MAX_HEIGHT, zoom)))
+
+
+# PROTOTYPE zoom ladder and helpers.
+ZOOM_STEPS = (0.75, 0.9, 1.0, 1.1, 1.25, 1.5, 1.75, 2.0)
+ZOOM_MIN, ZOOM_MAX = ZOOM_STEPS[0], ZOOM_STEPS[-1]
+
+
+def _zpx(n: float, zoom: float) -> int:
+    """``n`` logical px at ``zoom``: half-up (round() is banker's), >= 1 for n > 0."""
+    if n <= 0:
+        return 0
+    return max(1, int(n * zoom + 0.5))
+
+
+_QSS_PX = re.compile(r"(\d+)px")
+
+
+def _zqss(sheet: str, zoom: float) -> str:
+    """Every ``<int>px`` in an inline stylesheet, at ``zoom``."""
+    if zoom == 1.0:
+        return sheet
+    return _QSS_PX.sub(lambda m: f"{_zpx(int(m.group(1)), zoom)}px", sheet)
+
+
+def _zoom_step(current: float, direction: int) -> float:
+    """The next ladder value above (+1) or below (-1) ``current``; 0 resets."""
+    if direction == 0:
+        return 1.0
+    if direction > 0:
+        return next((z for z in ZOOM_STEPS if z > current + 1e-6), ZOOM_MAX)
+    return next((z for z in reversed(ZOOM_STEPS) if z < current - 1e-6), ZOOM_MIN)
 
 

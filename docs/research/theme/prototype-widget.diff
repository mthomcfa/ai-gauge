+def _on_fill(fill) -> str:
+    """White or near-black, whichever reads better on ``fill`` (WCAG luminance)."""
+    def lum(c):
+        ch = [v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4
+              for v in (c.redF(), c.greenF(), c.blueF())]
+        return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2]
+    lf = lum(QColor(fill))
+    return "#ffffff" if (1.05 / (lf + 0.05)) >= ((lf + 0.05) / (lum(QColor("#111827")) + 0.05)) else "#111827"
 
